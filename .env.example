# Copy this file to .env and paste your keys there. Never commit .env.
# Any key left blank falls back to an offline stand-in, so the film still runs.

# Character brains (Claude)
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-haiku-5-5 for faster, cheaper turns
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=low

# Sponsor tools
BRUIN_API_KEY=
BAND_API_KEY=
RUNWARE_API_KEY=
TELEM_API_KEY=
GLASSER_API_KEY=
FINCH_API_KEY=

# Story settings
INTERROGATION_ROUNDS=2
PORT=5173
